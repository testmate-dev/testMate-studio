  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://example.com/testmate.git"
  },
  "bugs": {
    "url": "https://example.com/testmate/issues"
  },
  "devDependencies": {
    "@babel/preset-react": "^7.0.0"
  },
  "dependencies": {
    "tms-runtime": "^3.5.10",
    "ink": "^2.4.0",
    "ink-select-input": "^3.1.0",
    "ink-spinner": "^3.0.0",
    "react": "^16.10.1",
    "selenium-webdriver": "^4.0.0-alpha.7"
  }
}
