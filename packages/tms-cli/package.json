  "private": true,
  "description": "Testmate cli",
  "author": "Testmate",
  "homepage": "https://example.com/testmate",
  "license": "Apache-2.0",
  "scripts": {
    "build": "babel --root-mode upward -d dist src --extensions \".js,.jsx,.ts,.tsx\" --source-maps true",
    "clean": "rm -rf dist",
    "prepublishOnly": "yarn clean && yarn build",
    "watch": "yarn build -w"
  },
  "main": "dist/index.js",
